{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**",
      "!**/node_modules",
      "!src/index.css"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": [
              "error",
              "warn"
            ]
          }
        },
        "noEmptyBlockStatements": "error"
      },
      "a11y": "off",
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      }
    }
  },
  "plugins": [
    "./lint/no-extends.grit"
  ],
  "overrides": [
    {
      "includes": [
        "src/i18n/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {},
                "patterns": [
                  {
                    "group": [
                      "../**",
                      "**/session",
                      "**/composition"
                    ],
                    "message": "i18n is a leaf: every part of the app imports it, so it imports nothing of the app (only solid-js)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/api/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {},
                "patterns": [
                  {
                    "group": [
                      "**/automation/**",
                      "**/chords/**",
                      "**/drums/**",
                      "**/effects/**",
                      "**/graph/**",
                      "**/history/**",
                      "**/instruments/**",
                      "**/keyboard/**",
                      "**/midi/**",
                      "**/mixer/**",
                      "**/pianoroll/**",
                      "**/plugins/**",
                      "**/presets/**",
                      "**/project/**",
                      "**/recording/**",
                      "**/samples/**",
                      "**/selection/**",
                      "**/settings/**",
                      "**/shell/**",
                      "**/sounds/**",
                      "**/stage/**",
                      "**/tracks/**",
                      "**/transport/**",
                      "**/core/**",
                      "**/common/**",
                      "**/mock/**",
                      "**/session",
                      "**/composition"
                    ],
                    "message": "api is the contract with the backend: it knows nothing of the roles, the core or the mock."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/core/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {},
                "patterns": [
                  {
                    "group": [
                      "**/automation/**",
                      "**/chords/**",
                      "**/drums/**",
                      "**/effects/**",
                      "**/graph/**",
                      "**/history/**",
                      "**/instruments/**",
                      "**/keyboard/**",
                      "**/midi/**",
                      "**/mixer/**",
                      "**/pianoroll/**",
                      "**/plugins/**",
                      "**/presets/**",
                      "**/project/**",
                      "**/recording/**",
                      "**/samples/**",
                      "**/selection/**",
                      "**/settings/**",
                      "**/shell/**",
                      "**/sounds/**",
                      "**/stage/**",
                      "**/tracks/**",
                      "**/transport/**",
                      "**/common/**",
                      "**/mock/**",
                      "**/session",
                      "**/composition",
                      "**/api/tauri*"
                    ],
                    "message": "The core is what every role shares: it knows the backend contract, never a role (roles ask the core, not the other way round)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/mock/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {},
                "patterns": [
                  {
                    "group": [
                      "**/session",
                      "**/core/**",
                      "**/composition",
                      "**/api/tauri*"
                    ],
                    "message": "The mock stands in for the backend: it may share the pure rules the backend mirrors, never the session or the core."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/**/*.tsx",
        "!src/App.tsx",
        "!src/index.tsx",
        "!src/session.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {},
                "patterns": [
                  {
                    "group": [
                      "**/api/api",
                      "**/api/rpc",
                      "**/api/dialogs",
                      "**/api/shell",
                      "**/api/tauri*",
                      "**/mock/**",
                      "**/composition",
                      "**/core/core",
                      "**/core/calls",
                      "**/core/projectSync"
                    ],
                    "message": "A component reads the session and asks its role (rule 4); it never calls the backend or the core itself."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
